%global abi @ABI@
%global payload @PAYLOAD@
%global debug_package %{nil}
%global __os_install_post %{nil}
%global __strip /bin/true
%global _build_id_links none
%undefine _missing_build_ids_terminate_build

Name:           kernel-sp11
Version:        @KVER@
Release:        @KREL@%{?dist}
Summary:        Linux kernel %{abi} for Microsoft Surface Pro 11 (Snapdragon X Elite)
License:        GPL-2.0-only
URL:            https://github.com/ooaklee/linux_ms_dev_kit-sp11
ExclusiveArch:  aarch64
AutoReqProv:    no

Provides:       kernel = %{version}-%{release}
Provides:       kernel-uname-r
Provides:       kernel-core-uname-r
Provides:       kernel-modules-core-uname-r
Provides:       installonlypkg(kernel)
Requires:       kmod
Requires:       dracut
Requires:       /usr/bin/kernel-install

%description
Surface Pro 11 integration kernel %{abi} from ooaklee/linux_ms_dev_kit-sp11
(commit @COMMIT@@STABLE@, release @RELEASE_TAG@, source mode: @MODE@), packaged for
Fedora's RPM, kernel-install, BLS and dracut lifecycle. Ships the Denali OLED
and LCD device trees under /usr/lib/modules/%{abi}/dtb/qcom. Unsigned.

%prep
%build

%install
cp -a %{payload}/. %{buildroot}/

%files
%defattr(-,root,root,-)
/boot/vmlinuz-%{abi}
/boot/System.map-%{abi}
/boot/config-%{abi}
/usr/lib/modules/%{abi}
%ghost /boot/initramfs-%{abi}.img

%posttrans
/usr/sbin/depmod -a %{abi} || :
/usr/bin/kernel-install add %{abi} /usr/lib/modules/%{abi}/vmlinuz || :

%preun
# Install-only package: when one version is erased while another stays, $1 is not 0, so remove the boot entry
# unconditionally, as Fedora's kernel packages do. A reinstall of the same version re-adds it in posttrans.
/usr/bin/kernel-install remove %{abi} || :

%changelog
* Sun Sep 13 2026 SP11 build <sp11@localhost> - @KVER@-@KREL@
- Package ooaklee kernel %{abi} for Fedora
