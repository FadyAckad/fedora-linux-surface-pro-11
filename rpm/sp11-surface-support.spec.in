%global stage @STAGE@
%global debug_package %{nil}
%global __os_install_post %{nil}
%global __strip /bin/true
%global _build_id_links none
%undefine _missing_build_ids_terminate_build

Name:           sp11-surface-support
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Surface Pro 11 device support: firmware, audio, Bluetooth, boot policy
License:        GPL-3.0-or-later AND LicenseRef-Proprietary-Firmware AND Bitstream-Vera
ExclusiveArch:  aarch64
AutoReqProv:    no

Requires:       bluez
Requires:       alsa-ucm
Requires:       dracut
# The dracut policy in 90-sp11.conf installs this package's Adreno microcode into the initramfs.
Requires:       qcom-firmware
Requires:       systemd
Requires:       systemd-udev
Requires:       grub2-tools-minimal
Requires:       grub2-tools
Requires:       grub2-efi-aa64-modules
Requires:       util-linux
Requires:       kmod

%description
Device-bound support for Microsoft Surface Pro 11 (X1E80100, OLED, SKU @SKU@):
Qualcomm ADSP/CDSP/GPU firmware extracted from this device's Windows installation,
ooaklee FullIO @AUDIO_TAG@ AudioReach topology and ALSA UCM, WCN7850 Wi-Fi board
data, Bluetooth public-address service, kernel-install boot policy plugin
(Denali DTB, GRUB resolution, kernel arguments), dracut policy, sysctl policy
(unprivileged user namespaces on the earlier AppArmor kernels), a GRUB menu entry that chainloads the
Windows Boot Manager, a dnf exclusion of the stock kernel packages, the first-boot
finalizer, and the SELinux restore for installations the live installer disabled it on.
The firmware is proprietary and must not be redistributed.
Inputs: @INPUTS@

%prep
%build

%install
cp -a %{stage}/. %{buildroot}/

# systemd's RPM file triggers reload units and udev rules and apply the sysctl file; both triggers below also
# run when this package is installed while their target is present.
%posttrans
# Installations made from media without active SELinux (the AppArmor kernels) carry the installer's selinux=0
# and SELINUX=disabled. The kernel-install plugin undoes that when the SELinux kernel is added; this call covers
# a support upgrade on a system that already has it, and runs first so the menu below is built from the
# cleaned GRUB_CMDLINE_LINUX. No-op elsewhere; never reboots.
/usr/libexec/sp11/sp11-selinux-restore || :
# Apply the /etc/default/grub policy and regenerate the GRUB menu on an installed system (the live root has
# no grub.cfg), so an upgrade that changes the policy takes effect without a reboot. Without the helper an
# upgrade would regenerate the menu from the previous policy: on an installed system nothing else runs it
# (the kernel-install plugin only on a kernel install, sp11-first-boot only once).
if [ -f /boot/grub2/grub.cfg ]; then
  /usr/libexec/sp11/sp11-grub-defaults || :
  /usr/sbin/grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1 || :
fi

%triggerin -- alsa-ucm
/usr/libexec/sp11/sp11-ucm-apply || :

%triggerin -- grub2-efi-aa64-modules
/usr/libexec/sp11/sp11-grub-modules || :

%files
%defattr(-,root,root,-)
/usr/lib/firmware/qcom/x1e80100/microsoft/Denali/
/usr/lib/firmware/qcom/x1e80100/X1E80100-Microsoft-Surface-Pro-11-tplg.bin
/usr/lib/firmware/ath12k/WCN7850/hw2.0/board.bin
/usr/share/alsa/ucm2/Qualcomm/x1e80100/MICROSOFT-Surface-Pro-11in.conf
/usr/share/alsa/ucm2/Qualcomm/x1e80100/SP11-HiFi.conf
/usr/share/sp11/
/usr/libexec/sp11/
/usr/lib/systemd/system/sp11-bluetooth-address@.service
/usr/lib/systemd/system/sp11-first-boot.service
/usr/lib/systemd/system/multi-user.target.wants/sp11-first-boot.service
/usr/lib/udev/rules.d/99-sp11-bluetooth-address.rules
/usr/lib/kernel/install.d/15-sp11-surface.install
/etc/grub.d/29_sp11_windows
/usr/lib/dracut/dracut.conf.d/90-sp11.conf
/usr/lib/sysctl.d/90-sp11.conf
/etc/dnf/libdnf5.conf.d/90-sp11.conf
%dir /etc/sp11
%config(noreplace) /etc/sp11/bluetooth-address
/etc/sp11/sp11.env

%changelog
* Sun Sep 13 2026 SP11 build <sp11@localhost> - @VERSION@-1
- Surface Pro 11 support payload
