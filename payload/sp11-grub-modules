#!/usr/bin/bash
# Make the GRUB module `chain` (the chainloader command) loadable at boot, for a GRUB image that lacks it.
# Fedora ships the version-matched module in grub2-efi-aa64-modules. GRUB resolves `insmod NAME` as
# $prefix/arm64-efi/NAME.mod and $prefix is /boot/grub2 on installed Fedora, so copy the module and its
# dependencies there. Fedora's aarch64 images 2.12-81 and 2.12-83 have the command built in: `insmod chain`
# does nothing there. With Secure Boot on, an `insmod` of a module file prints nothing (2.12-83) and the
# built-in command is the one that runs.
set -eu
src=/usr/lib/grub/arm64-efi
dst=/boot/grub2/arm64-efi
[ -d /boot/grub2 ] || exit 0

deps_of() {  # recursive dependency closure from moddep.lst
  local name=$1 dep
  printf '%s\n' "$name"
  for dep in $(sed -n "s/^$name: *//p" "$src/moddep.lst"); do deps_of "$dep"; done
}
install -d -m 0755 "$dst"
for mod in $(deps_of chain | sort -u); do
  [ -f "$src/$mod.mod" ] || continue
  cmp -s "$src/$mod.mod" "$dst/$mod.mod" || install -m 0644 "$src/$mod.mod" "$dst/$mod.mod"
done
