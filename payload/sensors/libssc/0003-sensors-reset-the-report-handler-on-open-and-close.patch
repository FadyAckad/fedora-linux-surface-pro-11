sensors: reset the report handler on open and close

Each sensor subclass connects its measurement handler to the client's
"report" signal in open and disconnects it in close, through one id in
its private data. An open while a handler is still connected (a second
open while the first waits, or an open after an open that failed)
overwrote the id and left the first handler connected, so every report
was then delivered twice, and the id was never cleared, so a second
close disconnected a handler that no longer existed.

Disconnect a leftover handler before connecting the new one, clear the
id on close, and drop the reference g_object_get() took on the client,
which both paths leaked.
---
 src/libssc-sensor-accelerometer.c | 8 +++++---
 src/libssc-sensor-compass.c       | 8 +++++---
 src/libssc-sensor-gyroscope.c     | 8 +++++---
 src/libssc-sensor-light.c         | 8 +++++---
 src/libssc-sensor-magnetometer.c  | 8 +++++---
 src/libssc-sensor-proximity.c     | 8 +++++---
 6 files changed, 30 insertions(+), 18 deletions(-)

diff --git a/src/libssc-sensor-accelerometer.c b/src/libssc-sensor-accelerometer.c
index 8579af0..2e8f193 100644
--- a/src/libssc-sensor-accelerometer.c
+++ b/src/libssc-sensor-accelerometer.c
@@ -29,7 +29,7 @@ enum {
 static guint signals[N_SIGNALS];
 
 typedef struct _SSCSensorAccelerometerPrivate {
-	guint report_id;
+	gulong report_id;
 } SSCSensorAccelerometerPrivate;
 
 G_DEFINE_TYPE_WITH_CODE (SSCSensorAccelerometer, ssc_sensor_accelerometer, SSC_TYPE_SENSOR,
@@ -147,8 +147,8 @@ ssc_sensor_accelerometer_close (SSCSensorAccelerometer *self, GCancellable *canc
 		      SSC_SENSOR_CLIENT, &client,
 		      NULL);
 
-	if (priv->report_id)
-		g_signal_handler_disconnect (client, priv->report_id);
+	g_clear_signal_handler (&priv->report_id, client);
+	g_object_unref (client);
 
 	/* Close sensor */
 	SSC_SENSOR_CLASS (ssc_sensor_accelerometer_parent_class)->close (SSC_SENSOR (self), cancellable, (GAsyncReadyCallback)accelerometer_close_ready, task);
@@ -209,10 +209,12 @@ ssc_sensor_accelerometer_open (SSCSensorAccelerometer *self, GCancellable *cance
 	g_object_get (SSC_SENSOR (self),
 		      SSC_SENSOR_CLIENT, &client,
 		      NULL);
+	g_clear_signal_handler (&priv->report_id, client);
 	priv->report_id = g_signal_connect (client,
 					    "report",
 					    G_CALLBACK (report_received),
 					    self);
+	g_object_unref (client);
 
 	/* Open sensor */
 	SSC_SENSOR_CLASS (ssc_sensor_accelerometer_parent_class)->open (SSC_SENSOR (self), cancellable, (GAsyncReadyCallback)accelerometer_open_ready, task);
