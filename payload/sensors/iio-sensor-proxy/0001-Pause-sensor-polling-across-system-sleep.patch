+static void
+release_sleep_lock (SensorData *data)
+{
+	if (data->sleep_lock_fd < 0)
+		return;
+
+	close (data->sleep_lock_fd);
+	data->sleep_lock_fd = -1;
+	g_debug ("Released the sleep delay lock");
+}
+
+static void
+take_sleep_lock_cb (GObject      *source_object,
+		    GAsyncResult *res,
+		    gpointer      user_data)
+{
+	SensorData *data;
+	g_autoptr(GError) error = NULL;
+	g_autoptr(GUnixFDList) fd_list = NULL;
+	g_autoptr(GVariant) ret = NULL;
+	gint32 idx;
+	int fd;
+
+	ret = g_dbus_connection_call_with_unix_fd_list_finish (G_DBUS_CONNECTION (source_object),
+							       &fd_list, res, &error);
+	/* Cancelled on exit, data is being freed */
+	if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+		return;
+
+	data = user_data;
+	g_clear_object (&data->sleep_lock_cancellable);
+
+	if (ret == NULL) {
+		if (g_error_matches (error, G_DBUS_ERROR, G_DBUS_ERROR_SERVICE_UNKNOWN) ||
+		    g_error_matches (error, G_DBUS_ERROR, G_DBUS_ERROR_NAME_HAS_NO_OWNER))
+			g_debug ("No logind, sensors will keep polling while the system sleeps");
+		else
+			g_warning ("Could not take a sleep delay lock: %s", error->message);
+		return;
+	}
+
+	g_variant_get (ret, "(h)", &idx);
+	fd = fd_list ? g_unix_fd_list_get (fd_list, idx, &error) : -1;
+	if (fd < 0) {
+		g_warning ("Could not take a sleep delay lock: %s",
+			   error ? error->message : "no file descriptor in the reply");
+		return;
+	}
+
+	/* The system started going to sleep while we were asking */
+	if (data->sleeping) {
+		close (fd);
+		return;
+	}
+
+	data->sleep_lock_fd = fd;
+	g_debug ("Took a sleep delay lock");
+}
+
+/* PrepareForSleep(true) alone does not make logind wait: a "delay" lock
+ * held while awake does, until it is released or InhibitDelayMaxSec */
+static void
+take_sleep_lock (SensorData *data)
+{
+	if (data->sleeping ||
+	    data->sleep_lock_fd >= 0 ||
+	    data->sleep_lock_cancellable != NULL)
+		return;
+
+	data->sleep_lock_cancellable = g_cancellable_new ();
+	g_dbus_connection_call_with_unix_fd_list (data->connection,
+						  LOGIND_DBUS_NAME,
+						  LOGIND_DBUS_PATH,
+						  LOGIND_IFACE_NAME,
+						  "Inhibit",
+						  g_variant_new ("(ssss)",
+								 "sleep",
+								 "iio-sensor-proxy",
+								 "Pause the sensor streams before the system sleeps",
+								 "delay"),
+						  G_VARIANT_TYPE ("(h)"),
+						  G_DBUS_CALL_FLAGS_NONE,
+						  -1,
+						  NULL,
+						  data->sleep_lock_cancellable,
+						  take_sleep_lock_cb,
+						  data);
+}
+
+/* Start or stop each sensor so that it polls if, and only if, it has
+ * clients and the system is not going to sleep. Drivers can iterate the
+ * main context while they start or stop a sensor (libssc's synchronous
+ * calls do), so a claim, a release or a sleep notification can arrive in
+ * the middle of this: such a nested call only makes the running one go
+ * round again, so a driver is never started or stopped re-entrantly. */
+static void
+reconcile_polling (SensorData *data)
+{
+	guint i;
+
+	if (data->reconciling) {
+		data->reconcile_again = TRUE;
+		return;
+	}
+
+	data->reconciling = TRUE;
+	do {
+		data->reconcile_again = FALSE;
+		for (i = 0; i < NUM_SENSOR_TYPES; i++) {
+			gboolean polling;
+
+			if (!driver_type_exists (data, i) || DEVICE_FOR_TYPE(i) == NULL)
+				continue;
+
+			polling = !data->sleeping && g_hash_table_size (data->clients[i]) > 0;
+			if (data->polling[i] == polling)
+				continue;
+
+			g_debug ("%s polling the %s",
+				 polling ? "Starting" : "Stopping",
+				 driver_type_to_str (i));
+			data->polling[i] = polling;
+			driver_set_polling (DEVICE_FOR_TYPE(i), polling);
+		}
+	} while (data->reconcile_again);
+	data->reconciling = FALSE;
+
+	/* Nothing polls any more, the system can go to sleep */
+	if (data->sleeping)
+		release_sleep_lock (data);
+}
+
+static void
+prepare_for_sleep_cb (GDBusConnection *connection,
+		      const gchar     *sender_name,
+		      const gchar     *object_path,
+		      const gchar     *interface_name,
+		      const gchar     *signal_name,
+		      GVariant        *parameters,
+		      gpointer         user_data)
+{
+	SensorData *data = user_data;
+	gboolean sleeping;
+
+	if (!g_variant_is_of_type (parameters, G_VARIANT_TYPE ("(b)")))
+		return;
+
+	g_variant_get (parameters, "(b)", &sleeping);
+	if (sleeping == data->sleeping)
+		return;
+
+	if (sleeping)
+		g_message ("Pausing sensor polling for system sleep");
+	else
+		g_message ("Resuming sensor polling after system sleep");
+
+	data->sleeping = sleeping;
+	/* Ask for the next lock first: the system may go back to sleep soon */
+	take_sleep_lock (data);
+	reconcile_polling (data);
+}
