+    def test_system_sleep(self):
+        '''no polling while the system sleeps'''
+        self.testbed.add_device('input', 'fake-light', None,
+            [],
+            ['NAME', '"Power Button"']
+        )
+        logind, obj_logind = self.spawn_server_template(
+            'logind', {}, stdout=subprocess.PIPE)
+        self.addCleanup(logind.stdout.close)
+        self.addCleanup(logind.wait)
+        self.addCleanup(logind.kill)
+        env = os.environ.copy()
+        env['FAKE_LIGHT_SENSOR'] = '1'
+        self.start_daemon(env)
+
+        def sleep_locks():
+            return [i for i in obj_logind.ListInhibitors()
+                    if i[0] == 'sleep' and i[1] == 'iio-sensor-proxy' and i[3] == 'delay']
+
+        def prepare_for_sleep(start):
+            obj_logind.EmitSignal('org.freedesktop.login1.Manager', 'PrepareForSleep', 'b',
+                                  [start], dbus_interface=dbusmock.MOCK_IFACE)
+
+        def level_after(seconds):
+            time.sleep(seconds)
+            return self.get_dbus_property('LightLevel')
+
+        # A delay lock while awake
+        self.assertEventually(lambda: len(sleep_locks()) == 1)
+        self.proxy.ClaimLight()
+        self.assertEventually(lambda: self.get_dbus_property('LightLevel') >= 1.0)
+
+        # No readings and no lock while the system sleeps
+        prepare_for_sleep(True)
+        self.assertEventually(lambda: self.have_text_in_log('Pausing sensor polling for system sleep'))
+        self.assertEventually(lambda: len(sleep_locks()) == 0)
+        level = self.get_dbus_property('LightLevel')
+        self.assertEqual(level_after(2.5), level)
+
+        # Readings and a new lock after the wake
+        prepare_for_sleep(False)
+        self.assertEventually(lambda: self.have_text_in_log('Resuming sensor polling after system sleep'))
+        self.assertEventually(lambda: self.get_dbus_property('LightLevel') > level)
+        self.assertEventually(lambda: len(sleep_locks()) == 1)
+
+        # A sensor released during the sleep stays off after the wake
+        prepare_for_sleep(True)
+        self.assertEventually(lambda: len(sleep_locks()) == 0)
+        self.proxy.ReleaseLight()
+        prepare_for_sleep(False)
+        self.assertEventually(lambda: len(sleep_locks()) == 1)
+        level = self.get_dbus_property('LightLevel')
+        self.assertEqual(level_after(2.5), level)
+
+        # A first claim during the sleep is answered with the first reading after the wake
+        prepare_for_sleep(True)
+        self.assertEventually(lambda: len(sleep_locks()) == 0)
+        replies = []
+        self.proxy.call('ClaimLight', None, Gio.DBusCallFlags.NONE, -1, None,
+                        lambda proxy, res, *args: replies.append(proxy.call_finish(res)))
+        ctx = GLib.MainContext.default()
+        deadline = time.time() + 1.5
+        while time.time() < deadline:
+            ctx.iteration(False)
+            time.sleep(0.05)
+        self.assertEqual(replies, [])
+        prepare_for_sleep(False)
+        self.assertEventually(lambda: len(replies) == 1)
+        self.assertEventually(lambda: self.get_dbus_property('LightLevel') > level)
+        self.assertEventually(lambda: len(sleep_locks()) == 1)
+
+        self.proxy.ReleaseLight()
+        self.stop_daemon()
+
