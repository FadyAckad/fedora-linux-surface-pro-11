#!/usr/bin/bash
# Surface Pro 11 sensor stack check (Snapdragon Sensor Core on the ADSP): boot timeline, initramfs contents,
# daemon, its file requests, QRTR service, one reading per sensor, iio-sensor-proxy, SELinux. Read-only; never
# touches the remoteproc state (stopping the ADSP hard-resets the SoC). Usage: sudo /usr/libexec/sp11/sp11-sensors-check
# (sp11-diag runs it as one of its sections)
set -u
sec() { printf '\n===== %s =====\n' "$*"; }
run() { printf '\n$ %s\n' "$*"; "$@" 2>&1 | head -n "${LINES_MAX:-200}"; }
sec "sensors: packages"; run rpm -q hexagonrpc libssc iio-sensor-proxy sp11-sensors qrtr
sec "sensors: boot timeline (the framework reads its files on the first attach after the ADSP booted)"
run sh -c "journalctl -b -k -o short-monotonic --no-pager | grep -iE 'remoteproc|fastrpc|qrtr|pd-mapper|sp11-sensors|hexagonrpcd|openat|opendir|oemconfig|Unsupported' | head -n 120"
run sh -c "journalctl -b -o short-monotonic --no-pager | grep -iE 'dracut-pre-udev|Switching root|switch-root|cryptsetup|hexagonrpcd-adsp-sensorspd|sp11-sensors-online|iio-sensor-proxy' | head -n 60"
# Per remote processor: the guard reacts to the ADSP only; the CDSP has crashed on its own (sleep_statsi.c:537).
run sh -c 'for r in adsp cdsp; do printf "%s crashes in this boot: %s\n" "$r" "$(journalctl -k -b -q --no-pager -g "crash detected in $r" | grep -c .)"; done'
run sh -c "journalctl -k -b -q --no-pager -g 'fatal error received|crash detected|recovering|is now up' -o short-monotonic | tail -n 12"
run sh -c "lsinitrd '/boot/initramfs-$(uname -r).img' 2>/dev/null | grep -E 'sp11-sensors|hexagonrpcd' || echo 'no sensors hook in the initramfs (expected since 1.3)'"
sec "sensors: ADSP and FastRPC"; run ls -l /dev/fastrpc-adsp /dev/fastrpc-cdsp
run sh -c 'for r in /sys/class/remoteproc/remoteproc*; do printf "%s %s %s\n" "$r" "$(cat "$r/name")" "$(cat "$r/state")"; done'
run udevadm info /sys/class/misc/fastrpc-adsp
sec "sensors: hexagonrpcd (root-side instance)"; run systemctl status hexagonrpcd-adsp-sensorspd.service --no-pager -l
# systemd reports ~620-640 MB for the daemon after the boot's first attach (flat for hours, ~0.2 MB after a resume's
# re-attach): whether that is anonymous memory, page cache, kernel memory or a DSP memory map request (apps_mem).
run sh -c 'cg=/sys/fs/cgroup/system.slice/hexagonrpcd-adsp-sensorspd.service; echo "memory.current $(cat "$cg/memory.current")"; grep -E "^(anon|file|kernel|kernel_stack|pagetables|percpu|sock|vmalloc|shmem|file_mapped|file_dirty|slab|slab_reclaimable|slab_unreclaimable) " "$cg/memory.stat"'
run sh -c 'p=$(systemctl show -p MainPID --value hexagonrpcd-adsp-sensorspd.service); [ "${p:-0}" != 0 ] || { echo "daemon not running"; exit 0; }; grep -E "^(VmPeak|VmSize|VmLck|VmPin|VmRSS|RssAnon|RssFile|RssShmem)" "/proc/$p/status"; echo "mappings: $(wc -l < "/proc/$p/maps")"; awk "\$6 != \"\" && \$6 !~ /\\.so|hexagonrpcd|^\\[(stack|vdso|vvar|vsyscall)\\]/" "/proc/$p/maps" | head -n 12'
run sh -c "journalctl -b --no-pager -u hexagonrpcd-adsp-sensorspd -o cat --all | grep -E '^mmap\(|Memory map failed|Unsupported mmap' | head -n 20 | grep . || echo 'no memory map request from the DSP in this boot'"
# The DSP's requests: what it wrote, removed or renamed and every refusal (the reads are hundreds of lines), then
# the first 120 lines (attach, configuration, registry check) and the last 40 (what it did last, and why the
# daemon stopped if it did).
run sh -c "journalctl -b --no-pager -u hexagonrpcd-adsp-sensorspd -o cat --all | wc -l"
run sh -c "journalctl -b --no-pager -u hexagonrpcd-adsp-sensorspd -o cat --all | grep -E '^(openat\(.*, (w|a|r\+|w\+|a\+)b?\)|remove|rename|truncate|close\(|Could not|Unsupported|Refusing|Starting|Large)' | grep -vE '^close\(' | uniq -c | head -n 120"
run sh -c "journalctl -b --no-pager -u hexagonrpcd-adsp-sensorspd -o cat --all | grep -cE '^write\(' || echo 0"
run sh -c "journalctl -b --no-pager -u hexagonrpcd-adsp-sensorspd -o cat --all | head -n 120"
run sh -c "journalctl -b --no-pager -u hexagonrpcd-adsp-sensorspd -o cat --all | tail -n 40"
run cat /run/sp11-sensors/attaches
run systemctl status sp11-sensors-online.service --no-pager -l; run journalctl -b --no-pager -t sp11-sensors -n 20
run ls -la @PAYLOAD_DIR@/sensors @PAYLOAD_DIR@/sensors/registry-parent @PAYLOAD_DIR@/socinfo
run sh -c 'ls @PAYLOAD_DIR@/sensors/registry | wc -l'
# The directory the daemon serves: sensors/persist is the DSP's /persist/sensors/registry (its temporary file lands
# there), persist/registry the registry copy (the DIR marker is one of its entries); the find below lists what the
# DSP wrote since this boot's attach.
run ls -la /var/lib/sp11/hexagonrpc /var/lib/sp11/hexagonrpc/sensors /var/lib/sp11/hexagonrpc/sensors/persist
run sh -c 'ls -la /var/lib/sp11/hexagonrpc/sensors/persist/registry | head -n 8; ls /var/lib/sp11/hexagonrpc/sensors/persist/registry | wc -l'
# Files the DSP wrote since the daemon's attach in this boot. The reference is the guard's attach marker, written
# seconds before the DSP writes with the same clock: the clock is hours behind at boot until NTP corrects it
# (RTC set by Windows), so a file installed with the corrected clock is no usable reference.
run sh -c 'ref=/run/sp11-sensors/attaches; [ -f "$ref" ] || ref=/usr/lib/tmpfiles.d/sp11-sensors.conf; echo "reference: $ref"; find /var/lib/sp11/hexagonrpc/sensors/persist -newer "$ref" -type f | wc -l; find /var/lib/sp11/hexagonrpc/sensors/persist -newer "$ref" -type f -printf "%TY-%Tm-%Td %TH:%TM %s %p\n" | head -n 20'
run sh -c 'stat -c "%Y %n" /var/lib/sp11/hexagonrpc/sensors/config/8380_crd_lsm6dsv_display.json; grep -o "\"8380_crd_lsm6dsv_display.json\":{[^}]*}" /var/lib/sp11/hexagonrpc/sensors/persist/registry/sns_reg_config'
sec "sensors: QRTR services"; run qrtr-lookup
sec "sensors: readings (ssccli, up to 8 s each; no line = the registry lookup hung and timeout killed it)"
for s in light accelerometer gyroscope magnetometer compass; do run timeout 8 stdbuf -oL ssccli --sensor "$s" --timeout 5; done
sec "sensors: iio-sensor-proxy"; run systemctl status iio-sensor-proxy.service --no-pager -l
run journalctl -b --no-pager -u iio-sensor-proxy -n 40
run timeout 5 monitor-sensor
sec "sensors: SELinux"; run getenforce; run sh -c "semodule -l | grep -E '^sp11' || echo 'no sp11 module loaded'"
run sh -c "journalctl -k -b --no-pager -g 'avc:  denied' | grep -E 'iiosensorproxy|hexagonrpc|fastrpc|qipcrtr' | tail -n 40"
# GNOME shows the auto-rotate toggle only while mutter's panel-orientation-managed is true: touch mode (a
# touchscreen, and a tablet-mode switch that is on, or no switch and no pointer device such as the keyboard's
# touchpad, attached or over Bluetooth) plus iio-sensor-proxy's accelerometer plus the built-in panel. Kernel SP11
# revision 2 registers "Microsoft Surface POS Tablet Mode Switch" for this machine (surface_aggregator_tabletsw; the
# KIP switch of ooaklee's and mainline's registry never changes state on this firmware); whether it exists and
# flips with the keyboard folded or detached is what this section shows. Run it in each keyboard state.
sec "tablet mode (what GNOME needs for the auto-rotate toggle)"
run sh -c "awk 'BEGIN{RS=\"\"} /B: SW=[0-9a-f]*[1-9a-f]/ {print; print \"\"}' /proc/bus/input/devices | grep -E '^(N|H|B: EV|B: SW)' || echo 'no input device with a switch (no tablet-mode switch)'"
run sh -c "grep -E '^N: ' /proc/bus/input/devices"
run sh -c "lsmod | grep -E '^surface_(aggregator|hid)' || echo 'no surface_aggregator modules loaded'"
run sh -c "journalctl -k -b --no-pager | grep -iE 'surface_aggregator|ssam|tablet|cover state|posture' | tail -n 40"
run sh -c "command -v libinput >/dev/null && libinput list-devices | grep -E '^(Device|Kernel|Capabilities|Tablet-mode)' || echo 'libinput not installed (sudo dnf install libinput-utils for libinput list-devices / debug-events)'"
run sh -c "busctl --system get-property net.hadess.SensorProxy /net/hadess/SensorProxy net.hadess.SensorProxy HasAccelerometer"
# mutter's property lives on the logged-in user's session bus; asked as that user when the check runs under sudo.
run sh -c 'u=${SUDO_USER:-}; uid=$(id -u "$u" 2>/dev/null); if [ -n "$u" ] && [ -S "/run/user/$uid/bus" ]; then runuser -u "$u" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" gdbus call --session --dest org.gnome.Mutter.DisplayConfig --object-path /org/gnome/Mutter/DisplayConfig --method org.freedesktop.DBus.Properties.Get org.gnome.Mutter.DisplayConfig PanelOrientationManaged; else echo "no session bus for ${u:-the calling user} (run from a terminal in the desktop session, with sudo)"; fi'
run sh -c "bluetoothctl devices Connected 2>/dev/null || echo 'bluetoothctl unavailable'"
