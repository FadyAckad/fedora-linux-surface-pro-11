# Surface Pro 11 5G: the Snapdragon X65 modem (PCI 17cb:0308, mhi-pci-generic).
# Its QMI port never answers: a request written to it stays queued, which keeps the driver from suspending (EBUSY),
# and ModemManager's probe of it takes 45 s at start and leaves a qmi-proxy that holds the shutdown for 45 s.
# ModemManager uses the MBIM port; the location service is reached over QRTR.
ACTION!="remove", SUBSYSTEM=="wwan", KERNEL=="wwan*qmi*", ATTRS{vendor}=="0x17cb", ATTRS{device}=="0x0308", ENV{ID_MM_PORT_IGNORE}="1"
# The GNSS feed for GeoClue listens while the modem is there.
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x17cb", ATTR{device}=="0x0308", TAG+="systemd", ENV{SYSTEMD_WANTS}+="sp11-gnss.socket"
