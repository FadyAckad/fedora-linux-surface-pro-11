 #include "iovec-util.h"
 
+/* SP11: true unless the command line carries sp11_stub=shim-loader. On the Surface Pro 11 shim's
+ * LoadImage() does not return for an image it has verified, so the kernel must not be handed to it. */
+extern bool sp11_own_loader;
+
