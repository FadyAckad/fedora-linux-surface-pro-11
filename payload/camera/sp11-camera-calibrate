def check(ok, what):
    print(f"{'ok  ' if ok else 'FAIL'} {what}")
    return ok


def synthetic_capture(directory, crosstalk, sensitivity, order='RGGB', width=600, height=400, frames=4):
    """A packed RAW10 capture of the chart: camera RGB = crosstalk x linear sRGB, times the channel sensitivities,
    on a black level of 64, with a little deterministic noise. Returns the JSON path and the corners."""
    corners = [(40, 30), (260, 30), (260, 170), (40, 170)]
    h = homography([(0, 0), (5, 0), (5, 3), (0, 3)], corners)
    centres = [project(h, i % 6, i // 6) for i in range(24)]
    exposure = 800 / matvec(crosstalk, REF_LINEAR[18])[1]
    colours = [[64 + exposure * sensitivity[c] * v for c, v in enumerate(matvec(crosstalk, rgb))]
               for rgb in REF_LINEAR]
    grey = [64 + exposure * sensitivity[c] * 0.2 for c in range(3)]
    names = QUAD[order]
    channel = {'R': 0, 'Gr': 1, 'Gb': 1, 'B': 2}
    stride = width * 5 // 4 + 18
    seed = [12345]

    def noise():
        seed[0] = (seed[0] * 1103515245 + 12345) & 0x7fffffff
        return (seed[0] >> 16) % 5 - 2
    data = bytearray()
    for _ in range(frames):
        for y in range(height):
            row = []
            for x in range(width):
                qx, qy = x // 2, y // 2
                colour = grey
                for i, (cx, cy) in enumerate(centres):
                    if abs(qx - cx) < 18 and abs(qy - cy) < 18:
                        colour = colours[i]
                v = colour[channel[names[2 * (y % 2) + x % 2]]] + noise()
                row.append(max(0, min(1023, round(v))))
            packed = bytearray()
            for g in range(0, width, 4):
                p = row[g:g + 4]
                packed += bytes(v >> 2 for v in p) + bytes([sum((v & 3) << (2 * j) for j, v in enumerate(p))])
            data += packed + bytes(stride - len(packed))
    with open(os.path.join(directory, 'synthetic.raw'), 'wb') as f:
        f.write(data)
    meta = dict(camera='synthetic', width=width, height=height, order=order, stride=stride,
                frame_size=stride * height, black=64, frames=frames, skip=1, file='synthetic.raw')
    path = os.path.join(directory, 'synthetic.json')
    with open(path, 'w') as f:
        json.dump(meta, f)
    return path, corners


def cmd_selftest(_args):
    ok = True
    white = matvec(XYZ_TO_SRGB, WHITE_D65)
    ok &= check(all(abs(v - 1) < 1e-9 for v in white), f'sRGB white point maps to 1, 1, 1: {white}')
    adapted = matvec(D50_TO_D65, WHITE_D50)
    ok &= check(all(abs(a - b) < 1e-9 for a, b in zip(adapted, WHITE_D65)), 'Bradford takes D50 white to D65 white')
    worst = max(abs(ciede2000(a, b) - e) for a, b, e in SHARMA)
    ok &= check(worst < 1e-4, f'CIEDE2000 matches Sharma et al.\'s {len(SHARMA)} pairs (worst {worst:.1e})')
    sat = saturation_matrix(1.3)
    ok &= check(all(abs(sum(r) - 1) < 1e-6 for r in sat), 'the saturation matrix leaves neutrals alone')
    ok &= check(abs(REF_LAB[21][0] - 50.76) < 0.05, f'neutral 5 keeps L* 50.76 through D65: {REF_LAB[21][0]:.3f}')
    crosstalk = [[0.70, 0.25, 0.05], [0.15, 0.70, 0.15], [0.05, 0.25, 0.70]]
    ideal = inv3(crosstalk)
    with tempfile.TemporaryDirectory(prefix='sp11-camera-calibrate-') as tmp:
        for order in ('RGGB', 'GRBG'):
            path, corners = synthetic_capture(tmp, crosstalk, [0.55, 1.0, 0.75], order)
            cap = Capture(path)
            means = cap.means(patch_squares(corners))
            r = fit([m for m, _ in means], [c for _, c in means], [64] * 3, set())
            # The chart's greys are not exactly neutral (a*, b* up to 0.75), so the balance they give differs from
            # the inverse sensitivities by their tint, and the matrix from the inverse crosstalk by a little more.
            cam = [[s * v for s, v in zip([0.55, 1.0, 0.75], matvec(crosstalk, REF_LINEAR[i]))] for i in BALANCE]
            want = [sum(c[1] for c in cam) / sum(c[i] for c in cam) for i in (0, 2)]
            ok &= check(abs(r['gains'][0] / want[0] - 1) < 0.002 and abs(r['gains'][2] / want[1] - 1) < 0.002,
                        f"{order}: white balance {r['gains'][0]:.4f}, {r['gains'][2]:.4f} "
                        f"(model {want[0]:.4f}, {want[1]:.4f})")
            dev = max(abs(r['ls'][i][j] - ideal[i][j]) for i in range(3) for j in range(3))
            ok &= check(dev < 0.03, f'{order}: least squares recovers the inverse crosstalk (worst {dev:.4f})')
            e = mean(errors(r['best'], r['cam'], r['k'], r['used']))
            ok &= check(e < 0.8, f'{order}: fitted mean dE00 {e:.3f}')
        # The synthetic noise is uniform over -2..2 (a deviation of sqrt(2)); noise reads it back.
        buf = io.StringIO()
        stdout, sys.stdout = sys.stdout, buf
        try:
            cmd_noise([path])
        finally:
            sys.stdout = stdout
        out = buf.getvalue().splitlines()
        sds = [float(x) for x in out[1].split()[5::3]] if len(out) > 1 else []
        ok &= check(len(sds) == 3 and all(1.2 < v < 1.65 for v in sds), f'noise reads the synthetic noise: {sds}')
        # A processed frame of the chart as libcamera would render it with the ideal matrix: evaluate must agree.
        w, h = 300, 200
        corners = [(40, 30), (260, 30), (260, 170), (40, 170)]
        hm = homography([(0, 0), (5, 0), (5, 3), (0, 3)], corners)
        centres = [project(hm, i % 6, i // 6) for i in range(24)]
        enc = [[round(255 * min(1.0, max(0.0, 0.8 * v)) ** (1 / 2.2)) for v in rgb] for rgb in REF_LINEAR]
        pixels = bytearray()
        for y in range(h):
            for x in range(w):
                colour = (60, 60, 60)
                for i, (cx, cy) in enumerate(centres):
                    if abs(x - cx) < 18 and abs(y - cy) < 18:
                        colour = enc[i]
                pixels += bytes(colour)
        ppm = os.path.join(tmp, 'frame.ppm')
        with open(ppm, 'wb') as f:
            f.write(b'P6\n# synthetic\n%d %d\n255\n' % (w, h) + pixels)
        lin = [[(v / 255) ** 2.2 for v in rgb] for rgb in ppm_means(*read_ppm(ppm), patch_squares(corners))]
        k = sum(lin[i][1] for i in BALANCE) / sum(REF_LINEAR[i][1] for i in BALANCE)
        e = mean([ciede2000(REF_LAB[i], linear_srgb_to_lab([v / k for v in lin[i]])) for i in range(24)])
        ok &= check(e < 1.0, f'a frame rendered from the chart reads back with mean dE00 {e:.3f} (8 bits, '
                             'cyan clipped)')
        png = os.path.join(tmp, 'preview.png')
        stdout, sys.stdout = sys.stdout, io.StringIO()
        try:
            cmd_preview([path, png, '--corners', ','.join(f'{c}' for p in corners for c in p)])
        finally:
            sys.stdout = stdout
        with open(png, 'rb') as f:
            data = f.read()
        length = struct.unpack('>I', data[33:37])[0]
        size = len(zlib.decompress(data[41:41 + length]))
        ok &= check(data[:8] == b'\x89PNG\r\n\x1a\n' and size == 200 * (1 + 3 * 300), 'preview writes a PNG')
    print('self-test passed' if ok else 'self-test FAILED')
    return 0 if ok else 1


def main():
    commands = dict(preview=cmd_preview, ccm=cmd_ccm, evaluate=cmd_evaluate, noise=cmd_noise, selftest=cmd_selftest)
    if len(sys.argv) < 2 or sys.argv[1] not in commands:
        sys.exit(__doc__.split('\n\n')[1])
    sys.exit(commands[sys.argv[1]](sys.argv[2:]) or 0)


if __name__ == '__main__':
    main()
