# Kernel config policy merged on top of ooaklee's annotations export by scripts/20-build-kernel.sh whenever
# KERNEL_SP11_REV in sp11.conf is set (Kconfig fragment syntax). Every change to an effective line needs a new
# KERNEL_SP11_REV with its KERNEL_SP11_REV_SHA256; comments do not count.
#
# Fedora's LSM stack (CONFIG_LSM and the security symbols as in Fedora's kernel-aarch64-fedora.config, f45)
# in place of Ubuntu's: SELinux active, as on Fedora's own kernels; AppArmor off, which also removes the
# CONFIG_SECURITY_APPARMOR_RESTRICT_USERNS user-namespace restriction behind the sysctl workaround. IPE is
# inert until a policy is loaded; "bpf" in the list needs CONFIG_BPF_LSM.
CONFIG_LSM="lockdown,yama,integrity,selinux,bpf,landlock,ipe"
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_SECURITY_IPE=y
CONFIG_BPF_LSM=y
# CONFIG_SECURITY_APPARMOR is not set
# Ubuntu's out-of-tree drivers under ubuntu/ (the IgH EtherCAT master is "default m").
# CONFIG_IGH_ECAT is not set
# CONFIG_UBUNTU_ODM_DRIVERS is not set
