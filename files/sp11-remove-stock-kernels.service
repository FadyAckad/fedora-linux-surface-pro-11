[Unit]
Description=Surface Pro 11: remove the hidden stock Fedora kernel (one shot)
ConditionKernelCommandLine=!rd.live.image
ConditionPathExists=!/var/lib/sp11/stock-kernels-removed.done
After=local-fs.target sp11-first-boot.service
Wants=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sp11/sp11-remove-stock-kernels
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
