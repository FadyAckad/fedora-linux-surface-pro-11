#!/usr/bin/bash
# Import Bluetooth pairings exported from Windows into BlueZ on this Fedora system.
# Usage: sudo sp11-bt-import-pairings [--from DIR]
# DIR holds <ADAPTER>/<DEVICE>/info directories as produced by scripts/70-export-bt-pairings.sh
# (default: the current directory, e.g. where sp11-bt-pairings.tar.gz was extracted).
# Existing device directories are backed up under /var/lib/sp11/.
set -euo pipefail
here=$PWD
[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }
while [ $# -gt 0 ]; do
  case "$1" in
    --from) here=$(cd "$2" && pwd); shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

shopt -s nullglob
infos=("$here"/*:*:*:*:*:*/*:*:*:*:*:*/info)
[ ${#infos[@]} -gt 0 ] || { echo "no <ADAPTER>/<DEVICE>/info files under $here (use --from DIR)" >&2; exit 1; }

backup=/var/lib/sp11/bluetooth-backup-$(date +%Y%m%d-%H%M%S)
# BlueZ reads info files only at startup, so stop it while replacing them.
running=0
if systemctl is-active --quiet bluetooth.service; then
  running=1
  systemctl stop bluetooth.service
  trap 'systemctl start bluetooth.service' EXIT
fi
for info in "${infos[@]}"; do
  dev=$(basename "$(dirname "$info")"); adapter=$(basename "$(dirname "$(dirname "$info")")")
  adir="/var/lib/bluetooth/$adapter"
  if [ ! -d "$adir" ]; then
    echo "adapter $adapter is unknown to BlueZ here (have: $(ls /var/lib/bluetooth 2>/dev/null | tr '\n' ' '))." >&2
    echo "The Linux controller must use the same address as Windows; check sp11-bluetooth-address@hci0.service." >&2
    exit 1
  fi
  if [ -d "$adir/$dev" ]; then
    install -d -m 0700 "$backup/$adapter"
    cp -a "$adir/$dev" "$backup/$adapter/"
    rm -rf "$adir/$dev"
  fi
  install -d -m 0700 "$adir/$dev"
  install -m 0600 "$info" "$adir/$dev/info"
  name=$(sed -n 's/^Name=//p' "$info" | head -1)
  echo "imported $dev ${name:+($name) }-> $adir/$dev/info"
done
if [ -d "$backup" ]; then echo "previous pairings backed up under $backup"; fi
if [ "$running" = 1 ]; then
  echo "restarting bluetooth; devices connect when they next advertise (press a key / touch the pen)"
else
  echo "bluetooth.service is not running; start it or reboot"
fi
